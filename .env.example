# npm run setup creates a private local .env only when absent.
# Add credentials locally; never commit them. No key is needed for npm run demo.
RECALL_PORT=4317
RECALL_DB=./data/recall.sqlite
# Read-only authenticated user's GitHub access token.
GITHUB_TOKEN=
# OAuth user token with bookmark.read, tweet.read, users.read; numeric X account ID.
X_ACCESS_TOKEN=
X_USER_ID=
# Official TypeSafe endpoint, never a third-party proxy.
JEV_API_KEY=
JEV_MODEL=jev-latest
# Optional embeddings-compatible provider (HTTP is allowed only for loopback).
# All three non-empty values enable semantic indexing. No default provider.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
